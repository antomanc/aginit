{
  "name": "ai-project-bootstrap",
  "version": "0.1.0",
  "description": "Minimal, modular AI-first project bootstrapper for T3 Code, Antigravity, and Codex",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ai": "./bin/ai.js",
    "ai-new": "./bin/ai-new.js",
    "ai-init": "./bin/ai-init.js",
    "ai-doctor": "./bin/ai-doctor.js"
  },
  "files": [
    "dist",
    "bin",
    "templates"
