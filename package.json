{
  "name": "@antomanc/aginit",
  "version": "0.1.0",
  "description": "Minimal, modular AI-first project bootstrapper for T3 Code, Antigravity, and Codex",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "aginit": "./bin/aginit.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antomanc/aginit.git"
  },
  "keywords": [
    "ai",
    "agents",
    "antigravity",
    "codex",
    "t3-code",
    "skills",
    "graft",
    "bootstrap",
    "scaffolder"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "license": "MIT"
}
