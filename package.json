{
  "name": "@antomanc/aginit",
  "version": "0.2.0",
  "description": "Set up a new or existing project for AI coding agents in one command: AGENTS.md, Matt Pocock skills, Graft codebase graph, Vitest/Playwright. Orchestrates upstream tools, idempotent.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "aginit": "./bin/aginit.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "author": "Antonio Mancuso <an.manc25@gmail.com>",
  "homepage": "https://github.com/antomanc/aginit#readme",
  "bugs": {
    "url": "https://github.com/antomanc/aginit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antomanc/aginit.git"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "coding-agents",
    "agents-md",
    "agent-skills",
    "codex",
    "antigravity",
    "graft",
    "scaffolder",
    "bootstrap",
    "project-template",
    "developer-tools",
    "cli",
    "vitest",
    "playwright"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepack": "tsc",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm audit",
    "check:skills": "node scripts/check-skill-drift.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "pnpm check && pnpm smoke"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.10.1"
}
